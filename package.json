{
  "name": "autowonder-claude-executor",
  "version": "0.3.0",
  "description": "Open-source AutoWonder community-edition executor powered by Claude Code (headless) — speaks the platform WebSocket executor protocol",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "awce": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "test:only": "node --test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "autowonder",
    "claude-code",
    "executor",
    "mcp",
    "multi-agent",
    "sdlc",
    "websocket",
    "ai-sdlc",
    "daemon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kittimzhe/autowonder-claude-executor.git"
  },
  "homepage": "https://github.com/kittimzhe/autowonder-claude-executor#readme",
  "bugs": {
    "url": "https://github.com/kittimzhe/autowonder-claude-executor/issues"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ]
}